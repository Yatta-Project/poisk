[Desktop Entry]
Name=Поиск
Name[en]=Poisk
GenericName=Application Launcher
GenericName[ru]=Лаунчер приложений
Comment=Fast GTK-native lightweight Spotlight alternative for Linux
Comment[ru]=GTK-ориентированный лёгкий аналог Spotlight
Exec=poisk --toggle
Icon=system-search
Terminal=false
Type=Application
Categories=Utility;Core;
Keywords=launcher;command;palette;search;calculator;poisk;поиск;
StartupNotify=false
NoDisplay=true
SingleMainWindow=true
StartupWMClass=io.github.mrlogiousbanana.poisk.app
Actions=preferences;

[Desktop Action preferences]
Name=Параметры
Name[en]=Preferences
Exec=poisk --preferences
Icon=preferences-system
