[Desktop Entry]
Name=Параметры Поиска
Name[en]=Poisk Preferences
GenericName=Launcher Preferences
GenericName[ru]=Параметры лаунчера
Comment=Настройка параметров лаунчера Поиск (GTK-аналог Spotlight)
Comment[en]=Configure Poisk launcher (GTK-native Spotlight alternative)
Exec=poisk --preferences
Icon=preferences-system
Terminal=false
Type=Application
Categories=Settings;DesktopSettings;Utility;
Keywords=launcher;command;palette;search;settings;preferences;poisk;поиск;параметры;настройки;
StartupNotify=true
StartupWMClass=io.github.mrlogiousbanana.poisk.preferences
NotShowIn=Pantheon;GNOME;pantheon;
